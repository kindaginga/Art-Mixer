<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Art Distribution Tool</AssemblyName>
    <Product>Art Distribution Tool</Product>
    <AssemblyTitle>Art Distribution Tool</AssemblyTitle>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>ADTConvert</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <CETCompat>false</CETCompat>
    <ApplicationIcon>ADT.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ADT.ico" LogicalName="ADT.ico" />
  </ItemGroup>

  <!-- Stamps the build with the commit it comes from, marked "-modified" when tracked files differ from it: InformationalVersion 1.0.0+<commit>. -->
  <Target Name="StampCommit" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="AdtCommit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="AdtChanges" />
    </Exec>
    <PropertyGroup>
      <AdtCommit Condition="'$(AdtCommit)' == ''">unknown</AdtCommit>
      <AdtCommit Condition="'$(AdtChanges)' != ''">$(AdtCommit)-modified</AdtCommit>
      <InformationalVersion>$(Version)+$(AdtCommit)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\external\MaterialLib\MaterialLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\mod\Data\ADT\vanilla-slots.json" Link="vanilla-slots.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
