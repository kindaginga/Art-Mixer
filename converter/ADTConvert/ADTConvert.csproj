<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ArtDistributionToolConverter</AssemblyName>
    <RootNamespace>ADTConvert</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\external\MaterialLib\MaterialLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\mod\Data\ADT\vanilla-slots.json" Link="vanilla-slots.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
