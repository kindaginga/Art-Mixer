# Writes BuildStamp.h with the commit the build comes from, marked "-modified" when tracked files differ from it; the file is rewritten only when that changes.
execute_process(COMMAND git rev-parse --short HEAD WORKING_DIRECTORY "${SOURCE}" OUTPUT_VARIABLE COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git status --porcelain --untracked-files=no WORKING_DIRECTORY "${SOURCE}" OUTPUT_VARIABLE CHANGES OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if (NOT COMMIT)
	set(COMMIT "unknown")
endif ()
if (CHANGES)
	set(COMMIT "${COMMIT}-modified")
endif ()
set(TEXT "#pragma once\n\nnamespace BuildStamp\n{\n\tinline constexpr auto COMMIT = \"${COMMIT}\"sv;\n}\n")
if (EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" OLD)
endif ()
if (NOT "${OLD}" STREQUAL "${TEXT}")
	file(WRITE "${OUTPUT}" "${TEXT}")
endif ()
