      "text": "Shuffle layout",
      "help": "New arrangement, same settings.",
      "action": {
        "type": "CallFunction",
        "form": "ArtMixer.esl|800",
        "function": "Shuffle"
      }
    },
    {
      "type": "button",
      "text": "Reset all settings",
      "help": "Everything back to default.",
      "action": {
        "type": "CallFunction",
        "form": "ArtMixer.esl|800",
